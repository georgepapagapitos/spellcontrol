# Backend environment. Local dev reads this file via
# `tsx watch --env-file .env`; production sets the same vars as Fly secrets
# (`fly secrets set …`). DATABASE_URL is set by the platform in prod (Neon).

# Postgres connection string. Required.
#   local dev: postgres://mtguser:mtgpassword@localhost:5432/spellcontrol
#   prod:      set as a Fly secret; points at Neon.
DATABASE_URL=postgres://mtguser:mtgpassword@localhost:5432/spellcontrol

# Signing key for session JWTs. Must be at least 16 chars; aim for 32+ random
# characters. Rotating this invalidates every active session.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Comma-separated emails that get the `admin` role, used ONLY to
# seed the first admin on a fresh database: every permission check reads
# users.role, and ongoing grants/revokes happen in the admin panel (which is
# keyed on the immutable user id). A match promotes only once the address is
# VERIFIED on the account, so listing an address somebody else signs up with
# hands out nothing. Additive — removing an address here never demotes anyone.
# Leave unset for an admin-less deploy.
#ADMIN_EMAILS=alice@example.com,bob@example.com

# Optional — "Continue with Google" sign-in. Leave all four unset to disable
# Google SSO entirely (the backend boots fine and the frontend hides the
# button). Create an OAuth 2.0 Client (type: Web application) in the Google
# Cloud Console and register the redirect URIs you use below.
#GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=your-client-secret
# Callback the browser/PWA flow uses (same origin as the web app).
#   dev:  http://localhost:5173/api/auth/google/callback  (through the Vite proxy)
#   prod: https://spellcontrol.com/api/auth/google/callback
#OAUTH_WEB_REDIRECT_URI=https://spellcontrol.com/api/auth/google/callback
# Callback the Capacitor app's flow uses (the backend's own origin). In prod
# the backend serves both the SPA and /api, so this is the same URL as the
# web one; in dev it's port 3737 because the app talks to the backend directly.
#   dev:  http://localhost:3737/api/auth/google/callback
#   prod: https://spellcontrol.com/api/auth/google/callback
#OAUTH_NATIVE_REDIRECT_URI=https://spellcontrol.com/api/auth/google/callback

# Optional — the AI surfaces ("Read the deck", refine). Absent key = the whole
# feature is off: /api/ai/* returns 404 and no AI UI renders, so the backend
# boots fine without it. Prod sets it as a Fly secret.
#ANTHROPIC_API_KEY=sk-ant-...
# While the AI features are experimental they are admin-only (see
# ADMIN_EMAILS), plus any account an admin unlocks from the admin panel.
# Set to 1 to open them to every account. Read fresh per request, so
# flipping it needs no rebuild.
#AI_PUBLIC=1

# Optional — outbound mail (account recovery: verify email, reset password).
# Unset = the backend logs the email body instead of sending it, so the flows
# still work end to end in dev/tests. Create a Resend API key and verify a
# sending domain (Resend dashboard → Domains → add spellcontrol.com, then add
# its DKIM/SPF/DMARC DNS records) before setting this in prod.
#RESEND_API_KEY=re_...
# From address. Must be on a domain verified with Resend above.
#MAIL_FROM=SpellControl <no-reply@spellcontrol.com>

# Optional — Digital Asset Links for the Android App Link that returns the
# Google OAuth callback into the installed APK. Comma-separated SHA-256
# signing-cert fingerprints (debug + release); case and colons don't matter.
# Unset → /.well-known/assetlinks.json 404s rather than advertising a
# half-broken statement.
#ANDROID_APP_FINGERPRINTS=AA:BB:CC:...,11:22:33:...

# Optional ops kill-switches, all `=1` to disable. Boot-time background work is
# deferred so it can't starve the health check; these turn a job off entirely
# when an instance needs the headroom.
#SCANNER_PRELOAD_DISABLED=1        # skip warming the card-scanner matcher
#SCRYFALL_BULK_INGEST_DISABLED=1   # skip the Scryfall bulk card ingest
#COMBOS_INGEST_DISABLED=1          # skip the Commander Spellbook ingest
#AGGREGATES_ROLLUP_DISABLED=1      # skip the aggregate rollup job
#RETENTION_DISABLED=1              # skip the daily data-retention sweep

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local). Vite inlines these at BUILD time — they are
# not runtime config and never Fly secrets; the prod bundle gets them as Docker
# build args in the deploy workflow.
# ---------------------------------------------------------------------------

# Which backend the bundle talks to. Unset → same-origin (correct for web).
# The native/Capacitor build must set it; see CLAUDE.md "Native app".
#VITE_API_BASE_URL=http://localhost:3737

# Optional — Google Drive picker on the import screen (web only; Google blocks
# OAuth in WebViews, so native falls back to the paste-a-link field). Both must
# be set or the Drive button hides itself. Both are PUBLIC (they ship in the
# bundle); the key's protection comes from its Cloud Console restrictions.
#
# ⛔ The API key must have Application restrictions = NONE. A "Websites (HTTP
#    referrer)" restriction looks like the responsible choice and silently
#    breaks the Picker: its backend never receives the hosting page's Referer,
#    so the restriction cannot match and every open fails with the misleading
#    "The API developer key is invalid" — sending you to fix Console settings
#    that are already correct. Cost five debugging rounds on 2026-08-18.
#
# ✅ DO keep API restrictions → Google Picker API + Google Drive API. That is
#    the restriction that works, and it caps a scraped key to those two APIs.
#    The key alone reads nothing: every Drive fetch needs the user's OAuth
#    token, so the exposure is quota, not data.
#
# The OAuth client must also list the app's origins under "Authorized
# JavaScript origins" (a different field from the redirect URIs above), and the
# client must live in the SAME Cloud project as the key — the Picker is handed
# that project number as its app id, derived from the client id.
#VITE_GOOGLE_API_KEY=your-browser-api-key
#VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional — passive uptime monitor (healthchecks.io). When set, the backend
# probes the PUBLIC https://spellcontrol.com/health every 5 minutes and pings
# this URL on a pass, <url>/fail on a failure. Unset = no heartbeat at all.
#HEALTHCHECKS_PING_URL=https://hc-ping.com/<uuid>
# Override the probed origin (point a local run at a bogus host to watch /fail).
#HEALTHCHECKS_PROBE_ORIGIN=https://spellcontrol.com
# Kill switch, same shape as the other *_DISABLED flags.
#UPTIME_HEARTBEAT_DISABLED=1
