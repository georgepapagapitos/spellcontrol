# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Backend
# Don't blanket-ignore backend/data/ — the scanner matcher's pHash +
# MobileCLIP artifacts under backend/data/scanner/ ship in git so the
# Docker image is reproducible across deploys (refreshed nightly by
# .github/workflows/scanner-ingest.yml). Ignore the SQLite cache files
# specifically instead.
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
# Stray runtime SQLite files at the backend root (e.g. a script run with a
# relative DB_PATH) — never source, keep them out of git status noise.
backend/*.db
backend/*.db-shm
backend/*.db-wal
backend/data/offline-oracle.*
backend/data/scryfall-bulk.meta.json
backend/dist/

# Frontend
frontend/dist/
frontend/.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.*.local

# Claude Code
.claude/
CLAUDE.md
AGENTS.md
docs/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Coverage / testing
coverage/
.nyc_output/

# Misc
*.pid
*.seed
*.pid.lock

# Agent-generated brainstorming/spec/plan docs — keep them out of the repo.
# (`docs/` itself stays usable for real project docs.)
docs/superpowers/

# Vitest run artifacts (the JSON reporter's output). Ignored EVERYWHERE, not
# just under backend/: `frontend/.vitest/json/output.json` was tracked, so every
# test run dirtied the working tree and the report's contents showed up in
# commits and PR diffs as noise.
#
# Tracking it is also an active false-green hazard. The report persists from the
# previous run, so a run that crashes or never starts leaves a stale "all
# passed" report on disk — which is exactly how a crashed suite got read as 98
# passing tests during the 2026-09-14 filter audit. Read exit codes, not this.
.vitest/
