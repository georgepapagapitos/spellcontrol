{
  // Base config: editor + `typecheck`. The CJS/ESM emit configs extend this.
  // Like game-core (and unlike binder-routing), most of the package lives in
  // `src/index.ts`; `template-query.ts` is the one other module, re-exported
  // from it with an explicit `.js` extension — `module: Node16` (the CJS
  // build) demands it on every relative import.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist/cjs",
    "declarationDir": "dist/types"
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
